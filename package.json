    "@remix-run/serve": "^2.3.1",
    "bcryptjs": "^2.4.3",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "isbot": "^3.6.8",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-auth": "^3.6.0",
    "remix-auth-form": "^1.4.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "prisma": "^5.7.0",
